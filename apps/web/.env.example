ANTHROPIC_API_KEY=
TYPESAFE_API_KEY=
# Optional: outfit visuals with Gemini's image model (higher tier).
GEMINI_API_KEY=
AI_MODEL_GATE=claude-haiku-5-5
AI_MODEL_OBSERVE=claude-opus-5-5
AI_MODEL_JUDGE=claude-opus-5-5
