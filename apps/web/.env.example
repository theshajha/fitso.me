DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_PRODUCT_REPORT_INR=
DODO_PRODUCT_REPORT_USD=
DODO_PRODUCT_PRO_INR=
DODO_PRODUCT_PRO_USD=
INR_PER_USD=84
OWNER_COOKIE_SECRET=
# Private testing: when set, /app/quick-win needs the code (entered once at /access).
ACCESS_CODE=
# Hard cap on full reads per day across all users (model spend guard).
MAX_READS_PER_DAY=200

# --- Dodo notes (T2 billing) ---
# Dodo only honours a per-checkout amount on pay-what-you-want products. Create each of the four
# DODO_PRODUCT_* products as one-time, pay-what-you-want, minimum = the lowest tier price
# (report INR 499 / USD 10, pro INR 1999 / USD 39). The app sends the tier price as the cart amount.
# Webhook endpoint: https://fitso.me/api/webhooks/dodo, events: payment.succeeded, refund.succeeded.
# Optional: set to test_mode to use Dodo's test environment (default live_mode).
DODO_ENVIRONMENT=
